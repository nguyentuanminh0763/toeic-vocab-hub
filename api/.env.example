# Sao chép thành .env khi chạy Nest trực tiếp (không Docker): cp .env.example .env
# Trong Docker Compose, biến được set trong docker-compose.yml (root repo).

PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=daypilot
DB_PASSWORD=daypilot_local
DB_DATABASE=daypilot
DB_SYNCHRONIZE=true
