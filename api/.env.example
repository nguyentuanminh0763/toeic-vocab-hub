# Sao chép thành .env khi chạy local: cp .env.example .env
# Trong Docker Compose, biến được set trong docker-compose.yml (root repo).

# Server
PORT=3000
CORS_ORIGIN=http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_DATABASE=toeic_vocab
# true cho dev (auto migrate), false cho production
DB_SYNCHRONIZE=true

# JWT — BẮT BUỘC đổi thành chuỗi ngẫu nhiên dài trước khi deploy
JWT_SECRET=change_me_to_a_long_random_string
